	email = sathishkumar786.ml@gmail.com

[init]
	defaultBranch = main

[core]
	editor = nvim
	autocrlf = input
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true       ; n / N to jump between diff hunks
	line-numbers = true
	dark = true
	side-by-side = false  ; set true for two-column diffs

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default

[alias]
	st = status
	co = checkout
	br = branch
	ci = commit
	lg = log --oneline --graph --decorate -20
	last = log -1 HEAD --stat
	unstage = reset HEAD --
	amend = commit --amend --no-edit

[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
