# .zshrc — managed by chezmoi

# Path
typeset -U path
path=($HOME/.local/bin $HOME/bin $HOME/.cargo/bin $path)
export PATH

# History
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt SHARE_HISTORY
setopt APPEND_HISTORY

# Key bindings (emacs style)
bindkey -e
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward

# Completion
autoload -Uz compinit && compinit
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' menu select

# mise — language version manager
if [ -f "$HOME/.local/bin/mise" ]; then
    eval "$($HOME/.local/bin/mise activate zsh)"
    export NODE_PATH="$(npm root -g 2>/dev/null)"
fi

# Starship prompt
if command -v starship &>/dev/null; then
    eval "$(starship init zsh)"
fi

# zoxide (smart cd)
if command -v zoxide &>/dev/null; then
    eval "$(zoxide init zsh)"
fi

# fzf — fast fuzzy finder. Ctrl-T = file search, Ctrl-R = history, Alt-C = cd.
if command -v fzf &>/dev/null; then
    eval "$(fzf --zsh 2>/dev/null)" || true
    # Use fd for fast, .gitignore-aware file/dir search (falls back to find).
    if command -v fd &>/dev/null; then
        export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
        export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
        export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
    fi
    export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border'
    # Preview file contents with bat in Ctrl-T.
    command -v bat &>/dev/null && \
        export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:200 {}'"
fi

# direnv — per-directory environments (.envrc auto-loads venvs / project vars).
if command -v direnv &>/dev/null; then
    eval "$(direnv hook zsh)"
fi

# atuin — searchable, synced shell history on Ctrl-R. Init after fzf so atuin
# owns Ctrl-R; --disable-up-arrow keeps the prefix history-search bound above.
if command -v atuin &>/dev/null; then
    eval "$(atuin init zsh --disable-up-arrow)"
fi

# Inline autosuggestions (fish/Warp-style grey ghost text from history).
# Accept whole suggestion: → (right arrow) or End. Accept one word: Ctrl-→.
if [ -f /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]; then
    source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
    ZSH_AUTOSUGGEST_STRATEGY=(history completion)
    bindkey '^ ' autosuggest-accept            # Ctrl-Space = accept suggestion
fi

# Conda
if [ -f "$HOME/miniforge3/etc/profile.d/conda.sh" ]; then
# . "$HOME/miniforge3/etc/profile.d/conda.sh"  # commented out by conda initialize
fi

# Aliases
alias ll='ls -alF --color=auto'
alias la='ls -A --color=auto'
alias l='ls -CF --color=auto'
alias lg='lazygit'
alias v='nvim'
alias g='git'
alias dc='docker compose'
alias gs='git status'
alias gd='git diff'
alias gp='git push'
alias gl='git log --oneline -20'
alias ..='cd ..'
alias ...='cd ../..'
alias cls='clear'

# --- QoL additions (managed by dotfiles) ---
# Modern ls via eza (override the plain ls aliases above)
if command -v eza >/dev/null; then
    alias ls='eza --group-directories-first --icons'
    alias ll='eza -l  --group-directories-first --icons --git'
    alias la='eza -la --group-directories-first --icons --git'
    alias lt='eza --tree --level=2 --icons'
fi
# bat as a nicer cat (no pager for inline use)
command -v bat >/dev/null && alias cat='bat --paging=never --style=plain'
# git shortcuts
alias ga='git add'
alias gco='git checkout'
alias gb='git branch'
alias gcm='git commit -m'
alias gst='git stash'
# wezterm persistent session (unix mux — survives GUI close/crash)
alias wtp='wezterm connect unix'
# zellij + maintenance
alias zj='zellij-pick'            # fzf session picker (attach/new)
alias dev='zellij --layout dev'   # editor + shells + git workspace
alias up='update-all'             # pacman+AUR+mise+chezmoi+flatpak
# mkdir + cd in one
mkcd() { mkdir -p "$1" && cd "$1"; }

# Un-leak the Flatpak environment. WezTerm is a Flatpak but spawns its shell on
# the HOST (no /.flatpak-info here), yet the sandbox's XDG_* and DBUS vars are
# still inherited. Left alone, every XDG-respecting tool in this terminal reads
# and writes ~/.var/app/org.wezfurlong.wezterm/* instead of the real dirs:
# chezmoi loses its source dir, gsettings/dconf read a phantom user db, and
# notify-send/gsettings writes fail against a bus socket that only exists inside
# the sandbox. Restore the host defaults.
if [[ -n "$FLATPAK_ID" && ! -f /.flatpak-info ]]; then
    export XDG_CONFIG_HOME="$HOME/.config"
    export XDG_DATA_HOME="$HOME/.local/share"
    export XDG_CACHE_HOME="$HOME/.cache"
    export XDG_STATE_HOME="$HOME/.local/state"
    export XDG_CONFIG_DIRS="/etc/xdg"
    export XDG_DATA_DIRS="/usr/local/share:/usr/share:/var/lib/flatpak/exports/share:$XDG_DATA_HOME/flatpak/exports/share"
    export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus"
    # ALSA_CONFIG_PATH points at /usr/share/alsa/alsa-flatpak.conf, which exists
    # ONLY inside the sandbox. On the host ALSA then loads no config at all, so
    # the "default" PCM never resolves and every capture dies with
    # "Unknown PCM default". That breaks arecord — which is what Claude Code's
    # /voice mode shells out to. Unset both so ALSA reads the host config and
    # picks up /etc/alsa/conf.d/50-pipewire.conf.
    unset ALSA_CONFIG_PATH ALSA_CONFIG_DIR
    unset FLATPAK_ID FLATPAK_SANDBOX_DIR
fi

# WezTerm shell integration. OSC 133 = semantic prompts (jump prompt-to-prompt
# Leader+Up/Down, copy last output Leader+y). OSC 7 = report the current dir so
# new tabs / panes / splits open in the SAME directory ("remember last path") and
# resurrect saves the real cwd. Self-contained — this box has no system
# wezterm.sh. No-op outside WezTerm.
if [[ "$TERM_PROGRAM" == "WezTerm" || -n "$WEZTERM_PANE" ]]; then
    # OSC 7: emit file://host/cwd, percent-encoding anything outside a safe set
    # (spaces, unicode) so paths with odd chars still resolve.
    __wt_osc7() {
        local LC_ALL=C i ch
        printf '\033]7;file://%s' "${HOST}"
        for (( i = 1; i <= ${#PWD}; ++i )); do
            ch="${PWD[i]}"
            if [[ "$ch" == [/._~A-Za-z0-9-] ]]; then
                printf '%s' "$ch"
            else
                printf '%%%02X' "'$ch"
            fi
        done
        printf '\033\\'
    }
    __wt_precmd() {
        local ret=$?
        printf '\033]133;D;%s\007' "$ret"   # end of previous command's output
        printf '\033]133;A\007'              # start of a new prompt
        __wt_osc7                            # report cwd (OSC 7)
    }
    __wt_preexec() { printf '\033]133;C\007'; }   # start of command output
    autoload -Uz add-zsh-hook
    add-zsh-hook precmd  __wt_precmd
    add-zsh-hook preexec __wt_preexec
    __wt_osc7   # report cwd immediately for the first prompt
fi

# Syntax highlighting (valid cmd = green, bad = red as you type).
# MUST be sourced LAST — it wraps the line editor.
if [ -f /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]; then
    source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/home/deva/miniforge3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/home/deva/miniforge3/etc/profile.d/conda.sh" ]; then
        . "/home/deva/miniforge3/etc/profile.d/conda.sh"
    else
        export PATH="/home/deva/miniforge3/bin:$PATH"
    fi
fi
unset __conda_setup
