# .zshrc — managed by chezmoi

# Path
typeset -U path
path=($HOME/.local/bin $HOME/bin $path)
export PATH

# History
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt SHARE_HISTORY
setopt APPEND_HISTORY

# Key bindings (emacs style)
bindkey -e
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward

# Completion
autoload -Uz compinit && compinit
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' menu select

# mise — language version manager
if [ -f "$HOME/.local/bin/mise" ]; then
    eval "$($HOME/.local/bin/mise activate zsh)"
    export NODE_PATH="$(npm root -g 2>/dev/null)"
fi

# Starship prompt
if command -v starship &>/dev/null; then
    eval "$(starship init zsh)"
fi

# zoxide (smart cd)
if command -v zoxide &>/dev/null; then
    eval "$(zoxide init zsh)"
fi

# fzf — fast fuzzy finder. Ctrl-T = file search, Ctrl-R = history, Alt-C = cd.
if command -v fzf &>/dev/null; then
    eval "$(fzf --zsh 2>/dev/null)" || true
    # Use fd for fast, .gitignore-aware file/dir search (falls back to find).
    if command -v fd &>/dev/null; then
        export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
        export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
        export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
    fi
    export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border'
    # Preview file contents with bat in Ctrl-T.
    command -v bat &>/dev/null && \
        export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:200 {}'"
fi

# Inline autosuggestions (fish/Warp-style grey ghost text from history).
# Accept whole suggestion: → (right arrow) or End. Accept one word: Ctrl-→.
if [ -f /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]; then
    source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
    ZSH_AUTOSUGGEST_STRATEGY=(history completion)
    bindkey '^ ' autosuggest-accept            # Ctrl-Space = accept suggestion
fi

# Conda
if [ -f "$HOME/miniforge3/etc/profile.d/conda.sh" ]; then
    . "$HOME/miniforge3/etc/profile.d/conda.sh"
fi

# Aliases
alias ll='ls -alF --color=auto'
alias la='ls -A --color=auto'
alias l='ls -CF --color=auto'
alias lg='lazygit'
alias v='nvim'
alias g='git'
alias dc='docker compose'
alias gs='git status'
alias gd='git diff'
alias gp='git push'
alias gl='git log --oneline -20'
alias ..='cd ..'
alias ...='cd ../..'
alias cls='clear'

# --- QoL additions (managed by dotfiles) ---
# Modern ls via eza (override the plain ls aliases above)
if command -v eza >/dev/null; then
    alias ls='eza --group-directories-first --icons'
    alias ll='eza -l  --group-directories-first --icons --git'
    alias la='eza -la --group-directories-first --icons --git'
    alias lt='eza --tree --level=2 --icons'
fi
# bat as a nicer cat (no pager for inline use)
command -v bat >/dev/null && alias cat='bat --paging=never --style=plain'
# git shortcuts
alias ga='git add'
alias gco='git checkout'
alias gb='git branch'
alias gcm='git commit -m'
alias gst='git stash'
# zellij + maintenance
alias zj='zellij-pick'            # fzf session picker (attach/new)
alias dev='zellij --layout dev'   # editor + shells + git workspace
alias up='update-all'             # pacman+AUR+mise+chezmoi+flatpak
# mkdir + cd in one
mkcd() { mkdir -p "$1" && cd "$1"; }

# Syntax highlighting (valid cmd = green, bad = red as you type).
# MUST be sourced LAST — it wraps the line editor.
if [ -f /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]; then
    source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi
