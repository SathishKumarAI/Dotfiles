#!/usr/bin/env bash
# One-shot system update — distro-aware. Alias: up
# Packages (auto-detected) + mise runtimes + chezmoi dotfiles + flatpak.
#
# Works on BOTH primary hosts:
#   • Rocky / Fedora / RHEL  -> dnf
#   • Arch / Manjaro         -> yay (AUR) or pacman
# Also handles Debian/Ubuntu (apt) and openSUSE (zypper) if you roam there.
set -uo pipefail

step() { printf '\n\033[1;35m== %s ==\033[0m\n' "$1"; }
have() { command -v "$1" >/dev/null 2>&1; }

# --- System packages: pick the manager this OS actually has ---------------
update_packages() {
    if   have yay;     then echo "[arch] yay -Syu";              yay -Syu
    elif have pacman;  then echo "[arch] pacman -Syu";           sudo pacman -Syu
    elif have dnf;     then echo "[rocky/fedora] dnf upgrade";   sudo dnf upgrade --refresh -y
    elif have apt;     then echo "[debian/ubuntu] apt update+upgrade"
                            sudo apt update && sudo apt upgrade -y
    elif have zypper;  then echo "[opensuse] zypper dup";        sudo zypper --non-interactive dup
    else echo "no known package manager (yay/pacman/dnf/apt/zypper) — skip"; fi
}

step "System packages"
update_packages

step "mise runtimes"
have mise && mise upgrade || echo "mise not found, skip"

step "chezmoi dotfiles (pull + apply)"
have chezmoi && chezmoi update --apply || echo "chezmoi not found, skip"

step "flatpak"
have flatpak && flatpak update -y || echo "flatpak not found, skip"

step "Done ✓"
